 # Copy to .env next to docker-compose.yml and fill in before deploying.

# --- Image version ---
# Which published tag to run for the api / indexer / migrate services. CI
# (.github/workflows/publish.yml) pushes a tag named after the git tag on tag
# pushes, and `nightly` on merges to develop.
#
# Production: pin an explicit release so a redeploy is reproducible.
#   VERSION=0.4.8
# Deploy with:
#   docker compose pull && docker compose up -d --no-build
# VERSION=nightly

# Override only if you publish elsewhere; these reproduce the CI image names
# ghcr.io/pshenmic/dashscan-api and ghcr.io/pshenmic/dashscan-indexer.
# REGISTRY=ghcr.io
# IMAGE_PREFIX=pshenmic/dashscan

# --- Which services to run in compose ---
# postgres, redis, dashd and frontend are all opt-in. Listing their profiles
# here means a plain `docker compose up -d` does the right thing per
# environment, with no --profile flags. Equivalent to passing --profile for each.
#
#   local-db        postgres
#   local-redis     redis
#   local-dashcore  dashd (Dash Core node)
#   local-frontend  frontend (skip it when the UI is served from a CDN etc.)
#
# Always started regardless: migrate, indexer, api, haproxy.
#
# Production: leave this commented out, so only the always-on services start and
# DATABASE_URL / REDIS_URL / CORE_RPC_HOST point at your external services.
#
# Local/dev: uncomment to run the whole stack self-contained. The defaults
# further down already use the matching in-compose hostnames.
COMPOSE_PROFILES=local-db,local-redis,local-dashcore,local-frontend

# --- Database ---
# Required. Used by both api and indexer.
#
# Production (external postgres) — run `docker compose up -d`:
#   DATABASE_URL=postgres://user:pass@db.your-host.tld:5432/dashscan
#
# Local/dev (postgres in compose) — run with `--profile local-db`, and keep
# the host as `postgres` so it resolves on the compose network:
DATABASE_URL=postgres://dashscan:change-me@postgres:5432/dashscan

# Only used when the local-db profile is enabled. Must agree with DATABASE_URL.
POSTGRES_USER=dashscan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dashscan

# --- Redis ---
# Required. Used by both api and indexer.
#
# Production (external redis) — run `docker compose up -d`:
#   REDIS_URL=redis://:password@redis.your-host.tld:6379
#
# Local/dev (redis in compose) — run with `--profile local-redis`, and keep
# the host as `redis` so it resolves on the compose network:
REDIS_URL=redis://redis:6379

# --- Network ---
# mainnet | testnet
NETWORK=mainnet

# --- Dash Core node ---
# Two options, same shape as the database:
#
# 1. External node — run `docker compose up -d` and point at it. For a node on
#    the same host as Docker, use host.docker.internal:
#      CORE_RPC_HOST=host.docker.internal
#      CORE_ZMQ_URL=tcp://host.docker.internal:29998
#      CORE_P2P_HOST=host.docker.internal
#
# 2. Bundled node — run with `--profile local-dashcore` and keep the hosts as
#    `dashd` so they resolve on the compose network (values below).
#    Note: a full mainnet chain needs ~40GB+ of disk.
CORE_RPC_HOST=dashd
CORE_RPC_PORT=9998
CORE_RPC_USER=dashmate
CORE_RPC_PASSWORD=change-me
CORE_ZMQ_URL=tcp://dashd:29998
CORE_P2P_HOST=dashd
CORE_P2P_PORT=9999

# Only used when the local-dashcore profile is enabled.
# CORE_CHAIN must agree with NETWORK: mainnet -> main, testnet -> test.
# CORE_ZMQ_PORT is the port dashd publishes on; it must match CORE_ZMQ_URL.
CORE_CHAIN=main
CORE_ZMQ_PORT=29998

# Block height the indexer starts from on an empty database.
START_HEIGHT=0

# --- Exposed ports ---
# API_PORT is published by haproxy, not by the api containers themselves.
#
# BIND_ADDR is the host interface both published ports bind to. The default
# 127.0.0.1 keeps them reachable only from the machine itself, which is what you
# want when a system haproxy/nginx terminates TLS and proxies to them. Use
# 0.0.0.0 to expose them directly on the network.
BIND_ADDR=127.0.0.1
API_PORT=3005
FRONTEND_PORT=3000

# --- Running several stacks on one host ---
# Each stack needs its own project name and its own ports; everything else
# (containers, networks, volumes) is namespaced by the project name, so the
# stacks stay fully independent — separate databases and chain data.
#
#   mainnet-a/.env:  COMPOSE_PROJECT_NAME=dashscan-mainnet-a  API_PORT=3005
#   mainnet-b/.env:  COMPOSE_PROJECT_NAME=dashscan-mainnet-b  API_PORT=3006
#   testnet-a/.env:  COMPOSE_PROJECT_NAME=dashscan-testnet-a  API_PORT=3007
#   testnet-b/.env:  COMPOSE_PROJECT_NAME=dashscan-testnet-b  API_PORT=3008
#
# The system haproxy then routes to 127.0.0.1:<API_PORT> per stack. Set
# FRONTEND_PORT (and CORE_P2P_PORT, if using the local-dashcore profile)
# uniquely per stack too.
# COMPOSE_PROJECT_NAME=dashscan

# --- Scaling ---
# Number of api containers behind haproxy. Raising this above the
# `server-template api 8` line in the inlined haproxy config (the `configs:`
# block at the bottom of docker-compose.yml) requires raising that too.
API_REPLICAS=4

# --- Frontend build-time config ---
# Must be the API URL as reachable from the user's browser, not from inside
# the compose network. Applied at image build time.
DASHSCAN_API_URL=https://api.your-domain.tldy
